{
  "tasks": {
    "check": "deno check _shared/apns.ts _shared/notification.ts _shared/supabase.ts alert-dispatch/index.ts",
    "test": "deno test --allow-env --no-check=remote",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "fmt": {
    "lineWidth": 110,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["README.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["deno.window", "deno.ns", "dom"]
  }
}
